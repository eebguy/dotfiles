#autoload
# Completion for programs that complete themselves the bash way (`complete -C prog prog`):
# HashiCorp tools (terraform, vault, nomad, consul, packer) and the AWS CLI
# (via aws_completer). The program reads the command line from COMP_LINE/COMP_POINT
# and prints one candidate per line. Registered by ~/.config/zsh/completions.zsh.

local completer=$words[1]
[[ $completer == aws ]] && completer=aws_completer

local line=${(j: :)words[1,CURRENT]}
local -a candidates
candidates=(${(f)"$(COMP_LINE=$line COMP_POINT=${#line} $completer $words[1] $words[CURRENT] $words[CURRENT-1] 2>/dev/null)"})
candidates=(${candidates%% })

if (( $#candidates )); then
  compadd -a candidates
else
  _files      # nothing from the program (file arguments, unknown flags): complete paths
fi
