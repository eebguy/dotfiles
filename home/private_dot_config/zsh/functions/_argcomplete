#autoload
# Completion for Python CLIs built on argcomplete: Azure CLI (az) and Google Cloud CLI
# (gcloud). The program runs in completion mode (_ARGCOMPLETE=1), reads COMP_LINE /
# COMP_POINT and writes candidates to file descriptor 8. Registered by
# ~/.config/zsh/completions.zsh. Each Tab starts the CLI, so expect ~0.5-1s.

local line=${(j: :)words[1,CURRENT]}
local -a candidates
candidates=(${(f)"$(_ARGCOMPLETE=1 _ARGCOMPLETE_IFS=$'\n' _ARGCOMPLETE_SUPPRESS_SPACE=1 \
  COMP_LINE=$line COMP_POINT=${#line} COMP_TYPE=9 \
  $words[1] 8>&1 9>/dev/null 2>/dev/null)"})
candidates=(${candidates%% })

if (( $#candidates )); then
  compadd -a candidates
else
  _files
fi
