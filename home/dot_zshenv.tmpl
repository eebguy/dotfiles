# ~/.zshenv — read by every zsh (interactive or not). Keep it tiny.
# Managed by chezmoi: edit with `chezmoi edit ~/.zshenv`.

# Ubuntu/Debian's /etc/zsh/zshrc runs compinit before our fpath is ready; ez-compinit does it.
skip_global_compinit=1

export EDITOR=nvim
export VISUAL=nvim
export MANPAGER='nvim +Man!'

typeset -U path fpath
path=(
  $HOME/.local/bin                       # install.sh vendor installs
  $HOME/go/bin                           # go install
  /usr/local/go/bin                      # system Go tarball (must precede /usr/local/bin)
  $path
)
{{- if and (eq .chezmoi.os "linux") (.chezmoi.kernel.osrelease | lower | contains "microsoft") }}

# WSL: appendWindowsPath=false in /etc/wsl.conf; add back only what's used from Linux.
path+=(
  /mnt/c/WINDOWS/system32                          # clip.exe, cmd.exe, wsl.exe
  /mnt/c/WINDOWS                                   # explorer.exe
  /mnt/c/WINDOWS/System32/WindowsPowerShell/v1.0   # powershell.exe
  '/mnt/d/Microsoft VS Code/bin'                   # code
)
{{- end }}

path=(${^path}(N-/))                     # drop directories that don't exist
